{
  "name": "gms-technical-solutions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "compiler": "node compiler/server.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 execute gms-db --local --file=./drizzle/0000_init.sql",
    "db:seed": "wrangler d1 execute gms-db --local --file=./drizzle/seed.sql",
    "db:remote": "wrangler d1 execute gms-db --remote --file=./drizzle/0000_init.sql",
    "db:seed:remote": "wrangler d1 execute gms-db --remote --file=./drizzle/seed.sql",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy:compiler": "cd compiler/cloudflare && npm install && npx wrangler deploy"
  },
  "dependencies": {
    "codemirror": "^5.65.16",
    "drizzle-orm": "^0.44.2",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/codemirror": "^5.60.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.20.0"
  }
}
